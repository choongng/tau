+    def _log_anomaly(self, msg: str) -> None:
+        """Record a band inconsistency: never fatal. The retune loop
+        rebuilds its view of the window from the mounted rows on every
+        tick, so an anomaly explains a stutter rather than breaking the
+        view."""
+        _BAND_ANOMALIES.append(msg)
+
