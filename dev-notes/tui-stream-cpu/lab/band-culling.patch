+    def _rows(self):
+        return [c for c in self.children
+                if isinstance(c, Widget)
+                and c is not self._top_boundary and c is not self._bottom_boundary]
+
+    def _item_of(self, row):
+        return getattr(row, "item", None)
+
+    def _measure(self):
+        for r in self._rows():
+            try:
+                h = r.region.height
+            except Exception:
+                continue
