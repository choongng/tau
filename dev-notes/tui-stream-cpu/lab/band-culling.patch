+class TranscriptView(TranscriptViewBase):
+    def __init__(self, *args, **kwargs):
+        self._pending_edge = False
+        self._pending_abs = 0.0
+        self._band_request = False
+        self._band_pending = None
+        super().__init__(*args, **kwargs)
+        self._heights = {}
+        self._pending = False
+        self._in_op = False
